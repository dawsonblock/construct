# Copy to .env before `docker compose up`. `make up` does this for you.
# Nothing here is a real credential — the defaults are local-only.

# --- Database -------------------------------------------------------------
# Compose overrides DATABASE_URL to point at the postgres service. This value
# is what a host-side process (tests, scripts/migrate.py) uses.
POSTGRES_DB=construction_ai
POSTGRES_USER=construction
POSTGRES_PASSWORD=construction
POSTGRES_PORT=5432
DATABASE_URL=postgresql://construction:construction@localhost:5432/construction_ai

# The application connects as a non-superuser role; RLS does not apply to
# superusers, so an app that uses DATABASE_URL has row-level security in name
# only. Migrations use DATABASE_URL; the API and worker use APP_DATABASE_URL.
APP_DATABASE_URL=postgresql://construction_app:construction_app@localhost:5432/construction_ai
APP_DB_PASSWORD=construction_app

# SQLite fallback, used only when DATABASE_URL is empty. Development/test only.
SQLITE_PATH=construction_ai_ops.db

# scripts/migrate.py owns the schema. Leave this off.
AUTO_MIGRATE=0

# --- Queue ----------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379
JOB_QUEUE=construction_ai:jobs
WORKER_ID=worker-1

# --- Object storage -------------------------------------------------------
# local = filesystem under OBJECT_STORE_ROOT; s3 = MinIO/S3 (compose uses s3).
OBJECT_STORE_BACKEND=local
OBJECT_STORE_ROOT=./object_store
S3_BUCKET=construction-ai-documents
S3_ENDPOINT_URL=http://localhost:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_DEFAULT_REGION=us-east-1
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- ERPNext --------------------------------------------------------------
# Default stack points at the in-repo stub. Swap for a live instance by setting
# a real base URL plus API key/secret.
ERP_NEXT_URL=http://localhost:8100
ERP_NEXT_API_KEY=
ERP_NEXT_API_SECRET=
ERPNEXT_STUB_PORT=8100

# --- API ------------------------------------------------------------------
API_PORT=8000
DEFAULT_ORGANIZATION_ID=ORG-DEMO

# --- Authentication -------------------------------------------------------
# How human approvers log in. 'dev' trusts a caller-supplied subject string
# inside the bootstrap/seeding boundary only — never for production. 'oidc'
# requires an external OIDC/OAuth2 issuer (wired in the production auth deploy).
CONSTRUCT_AUTH_PROVIDER=dev

# --- Mail connectors (Phase 4/5; unused by the v0.3 baseline) -------------
GMAIL_ACCESS_TOKEN=
MICROSOFT_GRAPH_ACCESS_TOKEN=

# Build app images with test dependencies (needed for `make test-stack`).
INSTALL_DEV=0
